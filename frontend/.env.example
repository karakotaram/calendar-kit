# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables. Both are read at build time and
# end up in the public JavaScript bundle, so never put a secret here.

# Public Mapbox token (starts with pk.). Required for the map when
# features.map is true in calendar.config.yaml; without it the site shows the
# list only. Restrict the token to your site's URL in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Optional. Overrides api.base_url from calendar.config.yaml, e.g. to point a
# local dev server at a local API: http://localhost:8199
# VITE_API_BASE_URL=
