# Every environment variable the backend reads, commented out with an example
# value. All are optional: an unset variable turns its feature off (and says so
# in the logs), never on. Set them in Railway's Variables and in GitHub's
# Actions secrets and variables; leave a line commented rather than empty.
# Regional settings - name, time zone, cities, features - live in
# calendar.config.yaml, not here.

# --- API (Railway, or wherever src/api/main.py runs) -----------------------

# Port to listen on; set by Railway and most hosts. Default 8000.
# PORT=8000
# Bearer token for choosing Editor's Picks at /admin. Unset: nobody can change picks.
# ADMIN_TOKEN=a-long-random-string
# Where picks are saved. On Railway mount a volume (e.g. at /state) and set
# /state/featured.json, or picks vanish at the next deploy - and the daily
# scrape's push redeploys every day. Default: data/featured.json in the checkout.
# FEATURED_PATH=/state/featured.json
# Enables /chat when calendar.config.yaml has features.chat: true. Also used by the
# optional Claude steps in the scrape (see below).
# ANTHROPIC_API_KEY=sk-ant-...
# The model /chat uses. Default claude-opus-5-5.
# CHAT_MODEL=claude-opus-5-5

# --- Scrape and sync (GitHub Actions; scripts/weekly_local_scrape.sh) ------

# "nominatim" to look up unknown venues on OpenStreetMap (one request a second,
# cached in data/geocode-cache.json). Unset: only data/venues.yaml is used.
# GEOCODER=nominatim
# The model the scrape's Claude steps use (categorizing uncategorized events,
# suggesting why a source went to zero). Default claude-opus-5-5. Needs ANTHROPIC_API_KEY.
# AGENT_MODEL=claude-opus-5-5
# "enforce" (default) blocks a run that fails the gate; "report" logs and publishes anyway.
# GATE_MODE=enforce
# Whether source-relative drift blocks publishing: "report" (default) or "enforce".
# GATE_DRIFT=report
# Lets the scrape open GitHub issues (gate blocked, sources stale or broken) via the gh CLI.
# GH_TOKEN=
# Set to "true" by GitHub Actions: CI skips sources registered runs_in_ci: false
# and keeps their events. GITHUB_ACTIONS is read the same way.
# CI=true
# Written by GitHub Actions; the submissions sync lists what it published there.
# GITHUB_STEP_SUMMARY=

# --- Reader submissions (sync_user_events.py) ------------------------------

# A Google Cloud service account's JSON key, on one line, with edit access to the
# response sheet named in calendar.config.yaml submissions.sheet_id.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# "1" to publish a submission only after someone marks its Approved cell yes.
# Unset: every new submission is published on the next sync.
# SUBMISSIONS_REQUIRE_APPROVAL=1

# --- Anywhere --------------------------------------------------------------

# Read a different config file instead of calendar.config.yaml.
# CALENDAR_CONFIG=calendar.config.yaml
